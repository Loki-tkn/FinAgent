# ==============================================================================
# FinAgent Copilot – Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# OpenRouter LLM Configuration
# ------------------------------------------------------------------------------
# Leave blank to use FinAgent's built-in 100% deterministic rule-based engine.
# Set your OpenRouter API key to activate advanced neural reasoning.
OPENROUTER_API_KEY=

# Model identifier on OpenRouter. Recommended choices:
#   • anthropic/claude-3.5-sonnet       (Balanced, best financial reasoning & code generation)
#   • google/gemini-2.0-flash-001       (Ultra-fast, cost-effective, real-time responses)
#   • deepseek/deepseek-r1              (Deep mathematical reasoning & Monte Carlo interpretation)
#   • meta-llama/llama-3.3-70b-instruct (Strong open-weights alternative)
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

# OpenRouter Endpoint & Metadata (Default values shown)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=https://github.com/FinAgent
OPENROUTER_TITLE=FinAgent_Copilot
